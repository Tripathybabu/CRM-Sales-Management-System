# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Number of reverse proxies in front of the app (1 on Render/Heroku/Nginx), 0 when running directly
TRUST_PROXY=0
LOG_LEVEL=info

# ---------------------------------------------------------------
# Database
# MongoDB MUST run as a replica set (transactions are used for lead conversion
# and every "change + audit entry" write). MongoDB Atlas works out of the box.
# Local docker-compose:  mongodb://localhost:27017/crm_sales?directConnection=true
# ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/crm_sales?directConnection=true

# ---------------------------------------------------------------
# Authentication
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=crm-sales-api
JWT_AUDIENCE=crm-sales-client
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
# When false, only admins can create accounts (POST /users)
ALLOW_PUBLIC_REGISTRATION=true

# Refresh-token cookie. In production over HTTPS use COOKIE_SECURE=true.
# Use COOKIE_SAME_SITE=none (with COOKIE_SECURE=true) only if the frontend is on a different site.
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------
# Seed script (npm run seed)
# ---------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@crm.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEFAULT_PASSWORD=Passw0rd!
